{
  "name": "mathsphere-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic mathematics learning, computation and visualization platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "node scripts/check-db.mjs",
    "db:studio": "drizzle-kit studio",
    "icons:web": "node scripts/generate-web-icons.mjs",
    "build:android-web": "node scripts/build-android-offline.mjs",
    "test:offline-sync": "node scripts/test-offline-sync.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build:android-web && cap sync android",
    "android:validate": "node scripts/validate-android-config.mjs",
    "android:assets": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^14.9.0",
    "katex": "^0.19.1",
    "next": "16.4.1",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.32",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
